generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            Int            @id @default(autoincrement())
  username      String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  role          String?        @default("REGISTERED") @db.VarChar(50)
  flagged       Boolean?       @default(false)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  meal_logs     meal_logs[]
  workout_logs  workout_logs[]
}

model workout_logs {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  exercise_name String    @db.VarChar(255)
  reps          Int
  weight        Float
  duration      Int
  sets          Int?
  rpe           Float?
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model meal_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  food_name  String    @db.VarChar(255)
  meal_type  String?   @default("lunch") @db.VarChar(50)
  calories   Int
  protein    Float
  fiber      Float
  carbs      Float
  fats       Float
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exercises {
  id                String              @id @db.VarChar
  name              String              @db.VarChar
  body_part         String              @db.VarChar
  target            String              @db.VarChar
  equipment         String              @db.VarChar
  gif_url           String?             @db.VarChar
  instructions      Json?
  session_exercises session_exercises[]
  workout_sets      workout_sets[]
}

model food_items {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  category    String?   @db.VarChar(100)
  calories    Decimal   @db.Decimal(6, 2)
  protein     Decimal   @db.Decimal(6, 2)
  carbs       Decimal   @db.Decimal(6, 2)
  fats        Decimal   @db.Decimal(6, 2)
  fiber       Decimal?  @default(0) @db.Decimal(6, 2)
  preparation String?   @default("Commercial/Packaged") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model session_exercises {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String           @db.Uuid
  exercise_id      String           @db.VarChar
  order_in_session Int              @default(1)
  notes            String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  exercises        exercises        @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  workout_sessions workout_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workout_sets     workout_sets[]

  @@index([session_id, order_in_session], map: "idx_session_exercises_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workout_sessions {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  name              String              @db.VarChar(150)
  status            String              @default("completed") @db.VarChar(20)
  start_time        DateTime            @default(now()) @db.Timestamptz(6)
  end_time          DateTime?           @db.Timestamptz(6)
  duration_seconds  Int                 @default(0)
  notes             String?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  session_exercises session_exercises[]
  workout_sets      workout_sets[]

  @@index([user_id, start_time(sort: Desc)], map: "idx_workout_sessions_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workout_sets {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_exercise_id String            @db.Uuid
  session_id          String            @db.Uuid
  user_id             String            @db.Uuid
  exercise_id         String            @db.VarChar
  set_number          Int
  weight              Decimal           @db.Decimal(8, 2)
  weight_unit         String            @default("kg") @db.VarChar(5)
  reps                Int
  rpe                 Decimal?          @db.Decimal(3, 1)
  is_warmup           Boolean           @default(false)
  is_personal_record  Boolean           @default(false)
  completed_at        DateTime          @default(now()) @db.Timestamptz(6)
  exercises           exercises         @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  session_exercises   session_exercises @relation(fields: [session_exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workout_sessions    workout_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, exercise_id, completed_at(sort: Desc)], map: "idx_workout_sets_progressive_overload")
}
